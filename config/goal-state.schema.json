{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "asset-delivery-organizer-goal-state/1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "goalId", "objective", "status", "stateRevision", "currentMilestone", "milestones", "nextSlice", "validationCommands", "lastCheckpoint", "guardrails"],
  "properties": {
    "schemaVersion": {"const": "codex-goal-state/1"},
    "goalId": {"const": "asset-delivery-organizer"},
    "objective": {"type": "string", "minLength": 10},
    "status": {"enum": ["active", "complete", "blocked"]},
    "stateRevision": {"type": "integer", "minimum": 1},
    "currentMilestone": {"type": ["string", "null"]},
    "milestones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "dependencies", "outcome"],
        "properties": {
          "id": {"type": "string", "pattern": "^M[0-9]+$"},
          "status": {"enum": ["pending", "in_progress", "completed"]},
          "dependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "outcome": {"type": "string", "minLength": 5}
        }
      }
    },
    "nextSlice": {
      "type": ["object", "null"],
      "properties": {
        "id": {"type": "string"},
        "milestone": {"type": "string"},
        "outcome": {"type": "string"},
        "risk": {"enum": ["R0", "R1", "R2", "R3", "R4"]},
        "allowedPaths": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "nonGoals": {"type": "array", "items": {"type": "string"}},
        "acceptance": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      },
      "required": ["id", "milestone", "outcome", "risk", "allowedPaths", "nonGoals", "acceptance"],
      "additionalProperties": false
    },
    "validationCommands": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "lastCheckpoint": {"type": "string", "pattern": "^artifacts/goal/checkpoint-[0-9]{4}\\.json$"},
    "guardrails": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
