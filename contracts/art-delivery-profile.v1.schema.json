{
  "$defs": {
    "EffectiveParameter": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[a-z][a-z0-9_.-]{1,79}$",
          "title": "Name",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/ParameterSource"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "name",
        "value",
        "source"
      ],
      "title": "EffectiveParameter",
      "type": "object"
    },
    "ParameterSource": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "default",
            "project_profile",
            "asset_override"
          ],
          "title": "Kind",
          "type": "string"
        },
        "reference": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Reference",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "reference"
      ],
      "title": "ParameterSource",
      "type": "object"
    },
    "RuleActivation": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "parameters": {
          "items": {
            "$ref": "#/$defs/EffectiveParameter"
          },
          "minItems": 1,
          "title": "Parameters",
          "type": "array"
        },
        "rule_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$",
          "title": "Rule Id",
          "type": "string"
        },
        "rule_version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Rule Version",
          "type": "string"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error",
            "blocker"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "rule_id",
        "rule_version",
        "severity",
        "parameters"
      ],
      "title": "RuleActivation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "asset_categories": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Asset Categories",
      "type": "array"
    },
    "profile_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,119}$",
      "title": "Profile Id",
      "type": "string"
    },
    "profile_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Profile Version",
      "type": "string"
    },
    "project_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{1,79}$",
      "title": "Project Id",
      "type": "string"
    },
    "rules": {
      "items": {
        "$ref": "#/$defs/RuleActivation"
      },
      "minItems": 1,
      "title": "Rules",
      "type": "array"
    },
    "schema_id": {
      "const": "art-delivery-profile/1",
      "default": "art-delivery-profile/1",
      "title": "Schema Id",
      "type": "string"
    }
  },
  "required": [
    "profile_id",
    "profile_version",
    "project_id",
    "asset_categories",
    "rules"
  ],
  "title": "DeliveryProfile",
  "type": "object"
}
